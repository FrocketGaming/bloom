{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bloom",
  "version": "0.1.0",
  "identifier": "app.bloom.textexpander",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "palette",
        "title": "Bloom search",
        "url": "palette.html",
        "width": 640,
        "height": 360,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": true,
        "center": true,
        "shadow": true,
        "windowEffects": { "effects": ["acrylic"] }
      },
      {
        "label": "settings",
        "title": "Bloom",
        "url": "settings.html",
        "width": 1000,
        "height": 680,
        "minWidth": 780,
        "minHeight": 500,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/icon.png", "icons/icon.ico"]
  }
}
