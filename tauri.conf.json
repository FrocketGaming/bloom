{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bloom",
  "version": "0.3.0",
  "identifier": "app.bloom.textexpander",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "palette",
        "title": "Bloom search",
        "url": "palette.html",
        "width": 640,
        "height": 360,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": true,
        "center": true,
        "shadow": true,
        "windowEffects": { "effects": ["acrylic"] },
        "additionalBrowserArgs": "--disable-gpu --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      },
      {
        "label": "dropdown",
        "title": "Bloom suggestions",
        "url": "dropdown.html",
        "width": 300,
        "height": 160,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "shadow": true,
        "windowEffects": { "effects": ["acrylic"] },
        "additionalBrowserArgs": "--disable-gpu --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "The Bloom contributors",
    "copyright": "Copyright (c) 2026 The Bloom contributors. MIT OR Apache-2.0.",
    "category": "Productivity",
    "shortDescription": "Text expander with a fast snippet search",
    "longDescription": "Bloom expands short triggers like ;sig into longer text in any app, and opens a snippet search on Ctrl+Shift+Space.",
    "homepage": "https://github.com/FrocketGaming/bloom",
    "license": "MIT OR Apache-2.0",
    "icon": ["icons/32x32.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh",
        "startMenuFolder": "Bloom"
      }
    }
  }
}
